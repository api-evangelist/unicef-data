{
  "opencollection": "1.0.0",
  "info": {
    "name": "GeoSight Basemap Related table API",
    "version": "v1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Related table",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "related-table-list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/related-tables/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "A page number within the paginated result set."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results to return per page."
              }
            ]
          },
          "docs": "Return list of accessible related tables for the user."
        },
        {
          "info": {
            "name": "related-table-create",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/related-tables/"
          },
          "docs": "Create a related table."
        },
        {
          "info": {
            "name": "related-table-detail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/related-tables/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Return detail of a related tables for the user."
        },
        {
          "info": {
            "name": "related-table-update",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/related-tables/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update a related table."
        },
        {
          "info": {
            "name": "related-table-partial-update",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/related-tables/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update an existing related table."
        },
        {
          "info": {
            "name": "related-table-delete",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/related-tables/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a related table."
        }
      ]
    }
  ],
  "bundled": true
}